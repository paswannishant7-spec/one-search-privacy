{
  "name": "one-search-privacy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/static-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "audit:lighthouse": "lighthouse http://127.0.0.1:3000 --output=html --output=json --output-path=artifacts/lighthouse/report --chrome-flags=\"--headless --no-sandbox\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "gsap": "^3.13.0",
    "lucide-react": "^0.554.0",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "lighthouse": "^13.6.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
